# Copy file này thành .env ở thư mục gốc của project
# Nhập API key của bạn từ OpenRouter (https://openrouter.ai/keys) hoặc OpenAI
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here

# OpenRouter API Base URL (nếu dùng OpenAI thì đổi thành https://api.openai.com/v1)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model ID: Có thể dùng model miễn phí trên OpenRouter hoặc OpenAI
# Ví dụ OpenRouter Free: nex-agi/nex-n2.5-pro:free hoặc google/gemma-4-26b-a4b-it:free
# Ví dụ OpenAI: gpt-4o-mini
OPENAI_MODEL=nex-agi/nex-n2.5-pro:free
